# Get Involved form — see docs/site-blueprint.md
#
# For local dev, these belong in `.dev.vars` (Cloudflare's runtime env file,
# read via `cloudflare:workers`), not this Vite-style `.env` file — this file
# just documents what's needed. In production, set the same names as
# Cloudflare Pages environment variables/secrets (Wrangler CLI or dashboard).
# Never commit real values.

# Resend (https://resend.com) — transactional email for form notifications
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile — CAPTCHA for the Get Involved form
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
