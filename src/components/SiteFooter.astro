---
import Logo from './Logo.astro';
import { locations } from '../lib/locations';
import { orgEmail, mailtoHref, isPlaceholder } from '../lib/contact';
import { socialLinks } from '../lib/social';

const year = new Date().getFullYear();

// Only show accounts with a real, audited URL — a footer of dead 404s reads
// worse than no links.
const liveSocial = socialLinks.filter((link) => !isPlaceholder(link.url));

const emailReady = !isPlaceholder(orgEmail);
---

<footer class="bg-kumkum-deep border-brass/30 border-t">
  <div class="px-gutter mx-auto max-w-6xl py-12">
    <div
      class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-start sm:justify-between sm:text-left"
    >
      <div>
        <Logo variant="white" />
        <p class="text-body text-sandal mt-4 max-w-xs">[PLACEHOLDER: one-line mission statement]</p>
        {
          liveSocial.length > 0 && (
            <ul class="mt-6 flex items-center justify-center gap-2 sm:justify-start">
              {liveSocial.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`I LOVE SAI on ${link.label} (opens in a new tab)`}
                    class="text-sandal hover:text-marigold inline-flex h-11 w-11 items-center justify-center rounded-md"
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                      <use href={`#social-${link.platform}`} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="text-body text-sandal flex flex-col gap-2">
        <p>
          {
            emailReady ? (
              <a href={mailtoHref()} class="text-sandal hover:text-marigold">
                {orgEmail}
              </a>
            ) : (
              <span>[PLACEHOLDER: real contact email]</span>
            )
          }
        </p>
        <p>
          {
            locations.map((location, i) => (
              <>
                {i > 0 && ' · '}
                <a
                  href={`/locations/${location.region.toLowerCase()}`}
                  class="text-sandal hover:text-marigold"
                >
                  {location.label}
                </a>
              </>
            ))
          }
        </p>
      </div>
    </div>

    <div
      class="border-brass/20 text-small text-sandal/80 mt-10 flex flex-col items-center gap-2 border-t pt-6 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <p>[PLACEHOLDER: registered charity name and registration number]</p>
      <p>&copy; {year} I LOVE SAI. All rights reserved.</p>
    </div>
  </div>

  {/* Brand icon paths, referenced by <use> above. Only emitted when a live social link exists. */}
  {
    liveSocial.length > 0 && (
      <svg width="0" height="0" class="hidden" aria-hidden="true">
        <defs>
          <path
            id="social-facebook"
            d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"
          />
          <path
            id="social-instagram"
            d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 3.24A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4zm0 10.89A4.29 4.29 0 1 1 16.29 12 4.29 4.29 0 0 1 12 16.29zm6.85-11.15a1.54 1.54 0 1 0 1.54 1.54 1.54 1.54 0 0 0-1.54-1.54z"
          />
          <path
            id="social-youtube"
            d="M23.5 6.5a3 3 0 0 0-2.12-2.12C19.5 3.86 12 3.86 12 3.86s-7.5 0-9.38.52A3 3 0 0 0 .5 6.5 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.5 3 3 0 0 0 2.12 2.12c1.88.52 9.38.52 9.38.52s7.5 0 9.38-.52a3 3 0 0 0 2.12-2.12A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.5zM9.6 15.57V8.43L15.82 12z"
          />
          <path
            id="social-reddit"
            d="M22 11.82a2.15 2.15 0 0 0-3.64-1.54 10.5 10.5 0 0 0-5.5-1.74l.94-4.4 3.06.65a1.54 1.54 0 1 0 .16-.98l-3.42-.72a.4.4 0 0 0-.47.31l-1.05 4.94a10.6 10.6 0 0 0-5.58 1.74 2.15 2.15 0 1 0-2.37 3.5 4.2 4.2 0 0 0-.05.65c0 3.3 3.85 5.98 8.6 5.98s8.6-2.68 8.6-5.98a4.2 4.2 0 0 0-.05-.64A2.15 2.15 0 0 0 22 11.82zM7 13.35a1.54 1.54 0 1 1 1.54 1.54A1.54 1.54 0 0 1 7 13.35zm8.58 4.06a5.6 5.6 0 0 1-3.58 1.04 5.6 5.6 0 0 1-3.58-1.04.38.38 0 1 1 .5-.58 4.9 4.9 0 0 0 3.08.84 4.9 4.9 0 0 0 3.08-.83.38.38 0 1 1 .5.57zm-.12-2.52a1.54 1.54 0 1 1 1.54-1.54 1.54 1.54 0 0 1-1.54 1.54z"
          />
          <path
            id="social-x"
            d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.66l7.73-8.84L1.24 2.25H8.1l4.71 6.23zm-1.16 17.52h1.83L7.01 4.13H5.04z"
          />
        </defs>
      </svg>
    )
  }
</footer>
