---
interface TimelineEvent {
  year: string;
  label: string;
  body: string;
}

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<ol class="my-10 flex flex-col gap-10">
  {
    events.map((event, i) => (
      <li class="relative flex gap-6">
        {i < events.length - 1 && (
          <span class="bg-brass/30 absolute top-4 left-2 h-10 w-px" aria-hidden="true" />
        )}
        <span class="bg-marigold relative z-10 block h-4 w-4 shrink-0 rounded-full" />
        <div>
          <p class="eyebrow">{event.year}</p>
          <h3 class="text-h3 mt-1">{event.label}</h3>
          <p class="text-body text-ink mt-1">{event.body}</p>
        </div>
      </li>
    ))
  }
</ol>
