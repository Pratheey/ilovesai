---
import PlaceholderImage from './PlaceholderImage.astro';
import { getLocation, type Region } from '../lib/locations';
import { sevaCategoryLabels, type SevaCategory, type SevaImage } from '../lib/seva';

interface Props {
  /** Anchor id, so an entry can be linked to directly: /seva#winter-food-drive. */
  id: string;
  title: string;
  date: Date;
  location: Region;
  category: SevaCategory;
  description: string;
  images?: SevaImage[];
  /** 'h4' under a year group's h3 — what the archive passes today. */
  headingLevel?: 'h3' | 'h4';
}

const {
  id,
  title,
  date,
  location,
  category,
  description,
  images,
  headingLevel = 'h4',
} = Astro.props;
const Heading = headingLevel;

const locationLabel = getLocation(location)?.label;

// Hardcoded 'en' for now — switch to the page's locale once i18n routing exists.
//
// Formatted in UTC deliberately. A seva date is a calendar day, not an instant,
// and `new Date('2026-07-12')` parses as UTC midnight — formatting that in the
// build machine's local zone renders it as 11 July anywhere west of Greenwich.
const dateFormatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// A card is a record, not a link: there is no per-entry detail page, so this is a
// <div>. At most three photos — the card is a summary, and a longer strip turns
// the grid into a gallery.
const shownImages = images?.slice(0, 3) ?? [];
---

<div
  id={id}
  data-seva-card
  data-category={category}
  data-location={location}
  class="border-brass/30 bg-sandal-deep shadow-soft flex flex-col overflow-hidden rounded-lg border"
>
  {
    shownImages.length > 0 && (
      // Columns follow the number of photos — a fixed 3-up leaves a dead cell
      // showing the brass backing when an entry has only one or two. The list
      // role survives Tailwind's list-style reset, and the label says which
      // entry these belong to, since the strip is read before the title.
      // eslint-disable-next-line astro/jsx-a11y/no-redundant-roles
      <ul
        role="list"
        aria-label={`Photos from ${title}`}
        class:list={[
          'photo-strip bg-brass/50 grid gap-px',
          shownImages.length === 1 && 'grid-cols-1',
          shownImages.length === 2 && 'grid-cols-2',
          shownImages.length >= 3 && 'grid-cols-3',
        ]}
      >
        {shownImages.map((item) => (
          <li class="aspect-square">
            {item.image ? (
              <img
                src={typeof item.image === 'string' ? item.image : item.image.src}
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              <PlaceholderImage label={item.imageAlt} />
            )}
          </li>
        ))}
      </ul>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    {
      /* mx-0 on every <p>: global.css gives paragraphs `margin-inline: auto`, and
        in a flex column an auto cross-axis margin shrink-wraps and centres the
        item — so without this the date and the footer line centre themselves
        while the title and description stay left. */
    }
    <p class="text-small text-brass-text mx-0">
      <time datetime={date.toISOString().slice(0, 10)}>{dateFormatter.format(date)}</time>
    </p>
    <Heading class="text-h3 mt-1">{title}</Heading>
    <p class="text-body text-ink mx-0 mt-2">{description}</p>

    {
      /* Category and place as plain metadata, matching EventCard. A bordered pill
        would add a shadcn-ish shape and a 1.41:1 border that can't be brought up
        to the 3:1 floor in any brass value that still looks like this palette. */
    }
    <p class="text-body text-ink-soft mx-0 mt-auto pt-4">
      {sevaCategoryLabels[category]} · {locationLabel}
    </p>
  </div>
</div>

<style>
  /* PlaceholderImage carries its own rounded border, which reads as a mistake
     inside a flush, brass-gapped strip that the card already clips. */
  .photo-strip li :global(*) {
    border-radius: 0;
    border-color: transparent;
  }
</style>
