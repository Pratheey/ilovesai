---
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  title: string;
  description: string;
  href?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
}

const { title, description, href, image, imageAlt } = Astro.props;
const Tag = href ? 'a' : 'div';
const linkProps = href ? { href } : {};
---

<Tag
  {...linkProps}
  class="bg-sandal-deep shadow-soft hover:shadow-lift block overflow-hidden rounded-lg transition-shadow"
>
  <div class="aspect-[4/3]">
    {
      image ? (
        <img
          src={typeof image === 'string' ? image : image.src}
          alt={imageAlt ?? ''}
          class="h-full w-full object-cover"
        />
      ) : (
        <PlaceholderImage label={imageAlt ?? title} />
      )
    }
  </div>
  <div class="p-5">
    <h3 class="text-h3">{title}</h3>
    <p class="text-body text-ink mt-1">{description}</p>
  </div>
</Tag>
