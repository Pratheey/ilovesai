---
const navLinks = [
  { href: '#projects', label: 'Projects' },
  { href: '#vision', label: 'Our Vision' },
  { href: '#participate', label: 'Ways to Participate' },
  { href: '#where', label: 'Where We Are' },
  { href: '#donate', label: 'Donate' },
];
---

<header class="border-brass/20 bg-sandal border-b">
  <div class="px-gutter mx-auto flex max-w-6xl items-center justify-between gap-4 py-4">
    <a href="/" class="font-display text-h3 text-kumkum">I LOVE SAI</a>

    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-body text-ink hover:text-ember">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#participate"
        class="bg-marigold text-small text-ink shadow-soft hover:shadow-lift inline-flex min-h-11 items-center justify-center rounded-md px-5 py-2 font-semibold"
      >
        Get Involved
      </a>

      <details class="relative lg:hidden">
        <summary
          class="border-brass/40 flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md border marker:content-none"
          aria-label="Menu"
        >
          <span aria-hidden="true">☰</span>
        </summary>
        <nav
          aria-label="Primary"
          class="border-brass/30 bg-cream shadow-lift absolute top-full right-0 z-10 mt-2 flex w-56 flex-col gap-1 rounded-lg border p-3"
        >
          {
            navLinks.map((link) => (
              <a href={link.href} class="text-body text-ink hover:text-ember rounded-sm px-2 py-2">
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
