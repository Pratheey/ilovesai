---
import { whatsappHref, mailtoHref } from '../lib/contact';

// The site's two front-door actions: a loud WhatsApp button (the primary path to
// the coordinator) and a quiet email button (the fallback). No form, no backend.
// The email is rendered as a button, never as scrapeable plaintext.
const whatsapp = whatsappHref();
const email = mailtoHref();

interface Props {
  /** Optional extra classes on the wrapper (spacing from context). */
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['flex flex-col items-center gap-4 sm:flex-row sm:justify-center', className]}>
  <a
    href={whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    class="bg-marigold text-body text-ink shadow-soft hover:shadow-lift inline-flex min-h-11 items-center justify-center gap-2.5 rounded-md px-6 py-3 font-semibold"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
      <path
        d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35zM12.02 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.42 9.42 0 0 1 14.63-11.6 9.36 9.36 0 0 1 2.76 6.67c0 5.2-4.23 9.35-9.4 9.35zM20.5 3.5A11.32 11.32 0 0 0 12.02 0C5.76 0 .66 5.1.66 11.35c0 2 .52 3.95 1.52 5.67L.56 24l7.15-1.88a11.3 11.3 0 0 0 5.4 1.38h.01c6.26 0 11.36-5.1 11.36-11.35 0-3.03-1.18-5.88-3.32-8.02z"
      ></path>
    </svg>
    Message us on WhatsApp
    <span class="sr-only"> (opens in a new tab)</span>
  </a>

  <a
    href={email}
    class="border-brass/50 text-body text-ink hover:border-ember hover:text-ember inline-flex min-h-11 items-center justify-center rounded-md border px-6 py-3 font-semibold"
  >
    Email us
  </a>
</div>
