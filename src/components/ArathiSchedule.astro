---
import { temples, formatArathiTime } from '../lib/arathi';

const hasTabs = temples.length > 1;
---

{
  temples.length > 0 && (
    <section
      aria-label="Today's arathi timings"
      data-arathi-tabs
      class="bg-kumkum-deep border-brass/25 rounded-xl border p-5 sm:p-6"
    >
      <p class="text-marigold text-eyebrow font-semibold tracking-[0.18em] uppercase">
        Today's Arathi
      </p>
      <p class="text-sandal mt-1 text-sm">Free and open to all.</p>

      {hasTabs && (
        <div
          role="tablist"
          aria-label="Choose a temple"
          class="arathi-tablist mt-4 flex gap-2 overflow-x-auto pb-1"
        >
          {temples.map((temple, i) => (
            <button
              type="button"
              role="tab"
              id={`arathi-tab-${temple.id}`}
              aria-controls={`arathi-panel-${temple.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="text-sandal border-brass/40 aria-selected:bg-marigold aria-selected:text-ink aria-selected:border-marigold hover:border-marigold inline-flex min-h-11 shrink-0 items-center rounded-full border px-4 text-sm font-semibold whitespace-nowrap"
            >
              {temple.name}
            </button>
          ))}
        </div>
      )}

      {temples.map((temple, i) => (
        <div
          id={`arathi-panel-${temple.id}`}
          role={hasTabs ? 'tabpanel' : undefined}
          aria-labelledby={hasTabs ? `arathi-tab-${temple.id}` : undefined}
          tabindex={hasTabs ? 0 : undefined}
          hidden={hasTabs && i !== 0}
          class="mt-4"
        >
          {temple.location && (
            <p class="text-sandal/70 mb-2 text-xs tracking-wide uppercase">{temple.location}</p>
          )}
          <ul class="bg-brass/25 grid grid-cols-2 gap-px overflow-hidden rounded-lg">
            {temple.arathis.map((arathi, i) => (
              <li
                class:list={[
                  'bg-kumkum-deep flex flex-col gap-0.5 px-4 py-3',
                  // An odd final cell would otherwise leave the brass backing
                  // showing as a solid block — span it across both columns.
                  temple.arathis.length % 2 === 1 &&
                    i === temple.arathis.length - 1 &&
                    'col-span-2',
                ]}
              >
                {arathi.note && (
                  <span class="text-sandal/80 text-eyebrow font-semibold tracking-[0.14em] uppercase">
                    {arathi.note}
                  </span>
                )}
                <span class="font-display text-sandal leading-tight">{arathi.name}</span>
                <span class="text-marigold font-semibold tabular-nums">
                  <time datetime={arathi.time}>{formatArathiTime(arathi.time)}</time>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )
}

<style>
  /* Scrollable tab strip without a visible scrollbar — the clipped edge of the
     next tab hints that the row scrolls. */
  .arathi-tablist {
    scrollbar-width: none;
  }
  .arathi-tablist::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Progressive enhancement: turn each [data-arathi-tabs] group into an accessible
  // tab widget. With JS off, the non-first panels stay `hidden` (set server-side),
  // so a no-JS visitor sees the primary temple. Single-temple groups are a no-op.
  document.querySelectorAll<HTMLElement>('[data-arathi-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    if (tabs.length < 2) return;
    const panels = tabs.map((tab) =>
      document.getElementById(tab.getAttribute('aria-controls') ?? ''),
    );

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = !selected;
      });
      // Keep the chosen tab visible when the strip is scrolled (many temples).
      tabs[index].scrollIntoView({ inline: 'nearest', block: 'nearest' });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (event: KeyboardEvent) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = i === last ? 0 : i + 1;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = i === 0 ? last : i - 1;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = last;
        if (next !== null) {
          event.preventDefault();
          select(next);
        }
      });
    });
  });
</script>
