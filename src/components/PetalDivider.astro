---
// PetalDivider — replaces plain horizontal rules with a fine marigold-petal
// garland line. Marigold garlands are what actually adorn Baba's shrine, so
// this draws a real petal shape (an almond/teardrop), not a circle or diamond
// standing in for one — and the petals are marigold, which is both the more
// truthful colour and the one that actually carries across a room. They were
// brass at 40%, which on the old near-white ground amounted to a grey smudge:
// a divider nobody could see is an ornament nobody asked for. The rule behind
// them stays brass, so the garland reads as petals strung on a wire.
//
// The petal is tiled via a native SVG <pattern> defined in absolute (pixel)
// user units with no viewBox on the root <svg> — so the coordinate system is
// 1:1 with rendered pixels and the tile repeats crisply at any width instead
// of stretching, however wide `full` ends up being.
//
// Purely decorative: aria-hidden + focusable="false" so it is never announced.

interface Props {
  variant?: 'full' | 'short' | 'single';
  class?: string;
}

const { variant = 'short', class: className = '' } = Astro.props;

// A symmetric almond/teardrop, pointed top and bottom, in a 16×16 box.
const petalPath = 'M8 1C11.5 4.5 11.5 11.5 8 15C4.5 11.5 4.5 4.5 8 1Z';

// Unique per instance so multiple dividers on one page don't collide on
// the <pattern> id (SVG ids are document-scoped).
const patternId = `petal-${Math.random().toString(36).slice(2, 9)}`;
---

{
  variant === 'single' ? (
    <svg
      aria-hidden="true"
      focusable="false"
      class={`mx-auto block h-4 w-4 ${className}`}
      viewBox="0 0 16 16"
    >
      <path d={petalPath} class="fill-marigold/80" />
    </svg>
  ) : (
    <svg
      aria-hidden="true"
      focusable="false"
      height="16"
      class={
        variant === 'full'
          ? `block h-4 w-full ${className}`
          : `mx-auto block h-4 w-[120px] ${className}`
      }
    >
      <defs>
        <pattern id={patternId} width="28" height="16" patternUnits="userSpaceOnUse">
          <path d={petalPath} class="fill-marigold/75" transform="translate(6 0) scale(0.75)" />
        </pattern>
      </defs>
      <line x1="0" y1="8" x2="100%" y2="8" class="stroke-brass/50" stroke-width="1" />
      <rect x="0" y="0" width="100%" height="16" fill={`url(#${patternId})`} />
    </svg>
  )
}
