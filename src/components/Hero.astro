---
import Carousel from './Carousel.astro';

interface Slide {
  image?: ImageMetadata | string;
  alt: string;
  caption?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  slides: Slide[];
}

const { eyebrow, heading, lead, ctaLabel, ctaHref, slides } = Astro.props;

// When an `aside` slot is provided (e.g. the arathi table), the heading block stays
// centered exactly as it does without one; the aside floats into the right margin on
// wide screens (xl+, where there's room beside the centered text) and stacks directly
// under the heading on smaller screens and mobile. Without an aside, nothing changes.
//
// At xl the two blocks are stacked in a single grid cell rather than the aside being
// taken out of flow with `absolute`. Visually identical — heading centred across the
// full width, aside pinned top-right — but the cell is now as tall as its tallest
// child, so an aside taller than the heading (the arathi schedule is) grows the hero
// instead of spilling out of it. Absolute positioning couldn't do that: the container
// ignored the aside's height entirely, which pushed it under the sticky header when
// centred and over the carousel below when top-aligned.
//
// The aside's `xl:mx-0` is load-bearing: `margin-inline: auto` centres a grid item
// within its area and beats `justify-self`, so without it the aside lands on top of
// the heading rather than in the right margin.
const hasAside = Astro.slots.has('aside');
---

<section class="dhuni-glow bg-sandal py-16 sm:py-24">
  <div class:list={['px-gutter mx-auto max-w-6xl', hasAside && 'xl:grid xl:items-start']}>
    <div class:list={['text-center', hasAside && 'mx-auto max-w-md xl:col-start-1 xl:row-start-1']}>
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1 class="text-display">{heading}</h1>
      {lead && <p class="text-lead text-ink-soft mx-auto mt-4 max-w-[var(--measure)]">{lead}</p>}
      {
        ctaLabel && ctaHref && (
          <a
            href={ctaHref}
            class="bg-marigold text-body text-ink shadow-soft hover:shadow-lift mt-8 inline-flex min-h-11 items-center justify-center rounded-md px-6 py-3 font-semibold"
          >
            {ctaLabel}
          </a>
        )
      }
    </div>

    {
      hasAside && (
        <div class="mx-auto mt-10 w-full max-w-sm xl:col-start-1 xl:row-start-1 xl:mx-0 xl:mt-0 xl:max-w-[17rem] xl:justify-self-end">
          <slot name="aside" />
        </div>
      )
    }
  </div>

  <div class="px-gutter mx-auto mt-12 max-w-5xl">
    <Carousel slides={slides} ariaLabel="Featured moments" />
  </div>
</section>
