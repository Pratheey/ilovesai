---
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  label: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** True for links that leave the site (e.g. an external hosted checkout) —
   * internal links (Serve/Organise anchors etc.) must not set this. */
  external?: boolean;
}

const { title, description, href, label, image, imageAlt, external } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class="border-brass/30 bg-cream hover:shadow-lift flex flex-col overflow-hidden rounded-lg border transition-shadow"
>
  <div class="aspect-[4/3]">
    {
      image ? (
        <img
          src={typeof image === 'string' ? image : image.src}
          alt={imageAlt ?? ''}
          class="h-full w-full object-cover"
        />
      ) : (
        <PlaceholderImage label={imageAlt ?? title} />
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-h3">{title}</h3>
    <p class="text-body text-ink mt-1 flex-1">{description}</p>
    <span class="text-small text-kumkum mt-4 font-semibold">
      {label} &rarr;
      {external && <span class="sr-only"> (opens in a new tab)</span>}
    </span>
  </div>
</a>
