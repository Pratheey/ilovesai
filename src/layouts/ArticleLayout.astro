---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SacredFrame from '../components/SacredFrame.astro';
import PhotoNeeded from '../components/PhotoNeeded.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  essence: string;
  headings: Heading[];
  /** 'band' (default): the HARD RULE treatment — the shared PageHeader, a
   * full-bleed photo carrying the title and essence over its warm scrim.
   * 'frame': the Sai Baba exception — styling-brief.md's imagery direction
   * says Baba's portrait must never carry overlaid text, so it sits in
   * SacredFrame with the essence beneath it instead. */
  imageTreatment?: 'band' | 'frame';
  heroImage?: ImageMetadata | string;
  heroImageAlt?: string;
  /** The shot description PhotoNeeded shows while heroImage is missing. */
  heroPhoto?: string;
}

const {
  title,
  essence,
  headings,
  imageTreatment = 'band',
  heroImage,
  heroImageAlt = '',
  heroPhoto,
} = Astro.props;

const tocItems = headings.filter((heading) => heading.depth === 2);
const showToc = tocItems.length >= 3;
---

<BaseLayout title={`${title} — I LOVE SAI`} description={essence}>
  {
    imageTreatment === 'frame' ? (
      <section class="bg-sandal px-gutter py-16 text-center sm:py-24">
        <div class="mx-auto max-w-6xl">
          <h1 class="text-display">{title}</h1>
          <div class="dhuni-glow mx-auto mt-10 max-w-md">
            <SacredFrame aspect="3:4">
              {heroImage ? (
                <img
                  src={typeof heroImage === 'string' ? heroImage : heroImage.src}
                  alt={heroImageAlt}
                  class="h-full w-full object-cover"
                />
              ) : (
                <PhotoNeeded description={heroPhoto ?? 'Photo needed'} aspect="3:4" />
              )}
            </SacredFrame>
          </div>
          <p class="text-lead text-ink-soft mx-auto mt-8 max-w-[var(--measure)]">{essence}</p>
        </div>
      </section>
    ) : (
      <PageHeader
        title={title}
        lead={essence}
        image={heroImage}
        imageAlt={heroImageAlt}
        photoDescription={heroPhoto ?? 'Photo needed'}
      />
    )
  }

  <div class="bg-cream px-gutter py-16 sm:py-24">
    {
      showToc ? (
        <div class="mx-auto max-w-6xl lg:grid lg:grid-cols-[240px_1fr] lg:gap-12">
          <aside>
            <details class="mb-10 lg:hidden">
              <summary class="eyebrow cursor-pointer">On This Page</summary>
              <nav aria-label="Table of contents" class="border-brass/20 mt-3 border-l pl-4">
                <ul class="flex flex-col gap-2">
                  {tocItems.map((item) => (
                    <li>
                      <a
                        href={`#${item.slug}`}
                        class="text-body text-ink-soft hover:text-ember-text"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>

            <nav aria-label="Table of contents" class="hidden lg:sticky lg:top-24 lg:block">
              <p class="eyebrow mb-3">On This Page</p>
              <ul class="border-brass/20 flex flex-col gap-2 border-l pl-4">
                {tocItems.map((item) => (
                  <li>
                    <a
                      href={`#${item.slug}`}
                      class="text-small text-ink-soft hover:text-ember-text"
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>

          <div class="prose">
            <slot />
          </div>
        </div>
      ) : (
        <div class="prose mx-auto max-w-[var(--measure)]">
          <slot />
        </div>
      )
    }
  </div>
</BaseLayout>
