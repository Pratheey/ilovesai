---
import BaseLayout from '../layouts/BaseLayout.astro';
import FrontDoorButtons from '../components/FrontDoorButtons.astro';
import ContactForm from '../components/ContactForm.astro';
import { locations, isPlaceholder, telHref } from '../lib/locations';

// The form is only rendered once Turnstile is configured. Without a challenge in
// front of it, a form posting to the org's inbox is a spam target — and the
// WhatsApp and email buttons above it already work, so the page is never
// left without a way through.
const formEnabled = Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---

<BaseLayout
  title="Contact — I LOVE SAI"
  description="Reach I LOVE SAI on WhatsApp, by email, or through the form, to ask a question, request an Aao Sai, or volunteer. Regional contacts in India, the UK, and the USA."
>
  <section class="dhuni-glow bg-sandal py-16 sm:py-24">
    <div class="px-gutter mx-auto max-w-3xl text-center">
      <h1 class="text-display">Contact</h1>
      <p class="text-lead text-ink-soft mx-auto mt-4 max-w-[var(--measure)]">
        [PLACEHOLDER: one warm line inviting visitors to reach out, to ask a question, request an
        Aao Sai, volunteer, or help with a local activity.]
      </p>
    </div>

    <div class="px-gutter mx-auto mt-14 grid max-w-5xl grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-h2">Reach us now</h2>
        <FrontDoorButtons direction="column" class="mt-6 max-w-sm" />
        <p class="text-body text-ink-soft mx-0 mt-4">
          The fastest way to reach a person on the team, not an inbox.
        </p>
      </div>

      <div class="max-w-xl">
        <h2 class="text-h2">Write to us</h2>

        {
          /* Revealed by :target after a no-JS form post, and directly by the script
            after a fetch submit. One message, both paths. */
        }
        <div
          id="sent"
          data-status-hidden
          class="form-status border-brass/80 bg-sandal-deep mt-8 rounded-md border p-6 text-left"
        >
          <p class="text-lead text-kumkum ml-0 font-semibold">
            Thank you, your message is on its way.
          </p>
          <p class="text-body text-ink mt-2 ml-0">
            Someone will reply to you by email. If it's urgent, WhatsApp is faster.
          </p>
        </div>

        <div
          id="send-failed"
          data-status-hidden
          class="form-status border-brass/80 bg-sandal-deep mt-8 rounded-md border p-6 text-left"
        >
          <p class="text-lead text-kumkum ml-0 font-semibold">That message didn't send.</p>
          <p class="text-body text-ink mt-2 ml-0">
            Please try again below, or reach us on WhatsApp or by email, those always work.
          </p>
        </div>

        {
          formEnabled ? (
            <div class="mt-8">
              <ContactForm />
            </div>
          ) : (
            <p class="text-body text-ink-soft mx-0 mt-8">
              The message form is being set up. In the meantime, WhatsApp and email on the left
              reach us just as well.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="regions-heading" class="bg-cream py-16 sm:py-24">
    <div class="px-gutter mx-auto max-w-6xl">
      <h2 id="regions-heading" class="text-h2 text-center">Regional Contacts</h2>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          locations.map((location) => (
            <div class="border-brass/80 bg-sandal rounded-md border p-6 text-center">
              <h3 class="text-h3">{location.label}</h3>
              {location.contactName && !isPlaceholder(location.contactName) && (
                <p class="text-body text-ink mt-2 break-words">{location.contactName}</p>
              )}
              {location.address && (
                <address class="text-body text-ink-soft mt-3 not-italic">
                  {location.address.map((line) => (
                    <>
                      {line}
                      <br />
                    </>
                  ))}
                </address>
              )}
              {location.email && (
                <p class="mt-3 break-words">
                  {isPlaceholder(location.email) ? (
                    <span class="text-body text-ink-soft">{location.email}</span>
                  ) : (
                    <a
                      href={`mailto:${location.email}`}
                      class="text-body text-kumkum hover:text-ember"
                    >
                      {location.email}
                    </a>
                  )}
                </p>
              )}
              {location.phone && (
                <p class="mt-1">
                  {isPlaceholder(location.phone) ? (
                    <span class="text-body text-ink-soft">{location.phone}</span>
                  ) : (
                    <a
                      href={telHref(location.phone)}
                      class="text-body text-kumkum hover:text-ember"
                    >
                      {location.phone}
                    </a>
                  )}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The no-JS path: the endpoint redirects to /contact#sent or #send-failed and
     the fragment alone reveals the right message.
     A `hidden` attribute can't be used for the resting state here — Tailwind's
     preflight sets `[hidden] { display: none !important }`, which no plain
     :target rule can override. Equal-specificity selectors, :target last, do the
     job without anyone needing !important. The script toggles the same
     attribute, so both paths drive one mechanism. */
  .form-status[data-status-hidden] {
    display: none;
  }
  .form-status:target {
    display: block;
  }
</style>
