---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SevaEntry from '../components/SevaEntry.astro';
import { sevaByYear } from '../lib/seva';

const groups = sevaByYear();
---

<BaseLayout
  title="Our Work — I LOVE SAI"
  description="A record of the charitable work carried out by I LOVE SAI — food distributions, cleaning and planting drives, and community gatherings in India, the UK, and the USA."
>
  {
    /* The standing copy carries a link, which the `lead` prop (a plain string)
      can't hold — so it goes through the slot instead, restyled for the dark
      ground. The link stays underlined, so colour is never the only thing
      marking it, and sandal-deep on hover clears AA against the scrim where
      marigold would not. */
  }
  <PageHeader
    title="Our Work"
    photoDescription="A cleaning drive underway in the Shirdi streets — brooms, bags, volunteers mid-work"
  >
    <p class="text-lead text-cream/90 mx-auto mt-4 max-w-[var(--measure)]">
      Everything I LOVE SAI has done, set down as it happened. Food distributions, cleaning drives,
      tree planting, and days spent with the communities around us. The ongoing work has{' '}
      <a href="/projects" class="hover:text-sandal-deep text-cream underline underline-offset-2"
        >its own pages</a
      >; this is the record of the individual days.
    </p>
  </PageHeader>

  <section aria-label="The record, by year" class="bg-cream py-16 sm:py-24">
    <div class="px-gutter mx-auto max-w-6xl">
      {
        groups.length === 0 ? (
          <p class="text-body text-ink-soft mx-auto mt-12 max-w-[var(--measure)] text-center">
            The record is being gathered. Check back soon.
          </p>
        ) : (
          <div class="flex flex-col gap-12">
            {groups.map((group) => (
              <div>
                <h2 class="text-h2 border-brass/20 border-b pb-2">{group.year}</h2>
                {/* Nothing in this grid is focusable, so list semantics are the only
                    structure a screen reader can move by — and Tailwind's
                    list-style reset drops them in Safari without the role. */}
                {/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles */}
                <ul
                  role="list"
                  class="md:divide-brass/20 mt-8 grid grid-cols-1 gap-y-12 md:grid-cols-2 md:divide-x"
                >
                  {group.entries.map((entry) => (
                    <li class="md:px-8 md:first:pl-0 md:last:pr-0">
                      <SevaEntry
                        id={entry.slug}
                        title={entry.title}
                        date={entry.date}
                        location={entry.location}
                        description={entry.description}
                        images={entry.images}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
