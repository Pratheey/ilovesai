---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoNeeded from '../../components/PhotoNeeded.astro';
import { team } from '../../lib/team';
---

<BaseLayout
  title="Meet the Team — I LOVE SAI"
  description="The people who serve behind I LOVE SAI."
>
  <PageHeader
    title="Meet the Team"
    lead="[PLACEHOLDER: one warm line about the people who serve — who you'll meet when you get involved.]"
    photoDescription="The team together at the end of a seva day — candid, faces visible, not a posed line-up"
  />

  {
    /* The guard moved outside the section: the title now lives in the header
      above, so an empty team would otherwise leave a bare cream strip here. */
  }
  {
    team.length > 0 && (
      <section class="bg-cream py-16 sm:py-24">
        <div class="px-gutter mx-auto max-w-6xl">
          <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
            {team.map((member) => (
              <li class="text-center">
                <div class="border-brass/80 mx-auto aspect-square max-w-[12rem] overflow-hidden rounded-lg border">
                  {member.image ? (
                    <img
                      src={typeof member.image === 'string' ? member.image : member.image.src}
                      alt={member.imageAlt ?? member.name}
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <PhotoNeeded
                      description={member.imageAlt ?? `Portrait of ${member.name}`}
                      aspect="1:1"
                    />
                  )}
                </div>
                <h2 class="text-h3 mt-4">{member.name}</h2>
                <p class="eyebrow mt-1">{member.role}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
