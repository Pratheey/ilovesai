---
import BaseLayout from '../layouts/BaseLayout.astro';
import FrontDoorButtons from '../components/FrontDoorButtons.astro';
import { DONATE_PATH } from '../lib/donate';
---

<BaseLayout
  title="Get Involved — I LOVE SAI"
  description="Reach I LOVE SAI on WhatsApp or by email to volunteer, host an Aao Sai, or help with a local activity."
>
  <section class="dhuni-glow bg-sandal py-16 sm:py-24">
    <div class="px-gutter mx-auto max-w-3xl text-center">
      <h1 class="text-display">Get Involved</h1>
      <p class="text-lead text-ink-soft mx-auto mt-4 max-w-[var(--measure)]">
        [PLACEHOLDER: one warm line inviting visitors to reach out — volunteer, host an Aao Sai, or
        help with a local activity.]
      </p>
      <FrontDoorButtons class="mt-10" />
      <p class="text-small text-ink-soft mt-6">
        A member of the team will personally welcome you and take it from there.
      </p>
    </div>
  </section>

  <section aria-labelledby="donate-heading" class="bg-cream py-16 sm:py-24">
    <div class="px-gutter mx-auto max-w-2xl text-center">
      <h2 id="donate-heading" class="text-h2">Prefer to give?</h2>
      <p class="text-body text-ink mt-3">
        [PLACEHOLDER: one line on how donations support the mission.]
      </p>
      <a
        href={DONATE_PATH}
        class="bg-marigold text-body text-ink shadow-soft hover:shadow-lift mt-8 inline-flex min-h-11 items-center justify-center rounded-md px-6 py-3 font-semibold"
      >
        See ways to give
      </a>
    </div>
  </section>
</BaseLayout>
