---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectRow, { type ProjectRowVariant } from '../../components/ProjectRow.astro';
import { projects } from '../../lib/projects';

// Every project gets a whole row. The variation is in the image treatment, not
// in size, so the page has rhythm without ranking the projects against each
// other — see ProjectRow.astro for the four shapes.
//
// Cycled by position rather than stored on each project, so the data model
// stays about the projects and a fifth project picks up a shape automatically.
// Reordering lib/projects.ts reshuffles the treatments; that's the intended
// control.
const VARIANTS: ProjectRowVariant[] = ['feature', 'pair', 'overlay', 'portrait'];

// Grounds alternate around the full-bleed row, which supplies its own.
const GROUNDS = ['bg-cream', 'bg-sandal', 'bg-cream', 'bg-cream'];
---

<BaseLayout
  title="Our Projects — I LOVE SAI"
  description="Ongoing projects and charitable activities from the I LOVE SAI community."
>
  <PageHeader
    title="Our Projects"
    lead="[PLACEHOLDER: intro line for the Projects index]"
    photoDescription="Volunteers mid-work on a food distribution — hands, trays, a queue of people"
  />

  {
    projects.map((project, i) => (
      <ProjectRow
        project={project}
        variant={VARIANTS[i % VARIANTS.length]}
        background={GROUNDS[i % GROUNDS.length]}
      />
    ))
  }

  <section class="bg-sandal-deep py-12">
    <div class="px-gutter mx-auto max-w-6xl text-center">
      <p class="text-body text-ink">
        For a record of what has actually been done, see <a
          href="/seva"
          class="text-kumkum hover:text-ember-text font-semibold underline underline-offset-2"
          >Our Work</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
