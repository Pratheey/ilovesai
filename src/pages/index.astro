---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTACard from '../components/CTACard.astro';
import ArathiSchedule from '../components/ArathiSchedule.astro';
import SpecialEvent from '../components/SpecialEvent.astro';
import ImageBand from '../components/ImageBand.astro';
import PetalDivider from '../components/PetalDivider.astro';
import { DONATE_PATH } from '../lib/donate';
import { projects } from '../lib/projects';
import { locations } from '../lib/locations';

// Shot list order 1–3 from styling-brief.md — these unblock the most.
const heroSlides = [
  { alt: 'Devotees gathered at a Sai Baba temple' },
  { alt: 'The dhuni and Dwarkamai — the perpetual fire, the interior' },
  { alt: 'Marigold garlands at a Thursday aarti' },
];

const participateOptions = [
  {
    title: 'Donate',
    description: '[PLACEHOLDER: one-line description of how donations are used]',
    href: DONATE_PATH,
    label: 'Donate',
    imageAlt: '[PLACEHOLDER: photo representing giving]',
  },
  {
    title: 'Serve',
    description: '[PLACEHOLDER: one-line description of volunteering / seva opportunities]',
    href: '/contact',
    label: 'Get involved',
    imageAlt: '[PLACEHOLDER: photo of devotees volunteering]',
  },
  {
    title: 'Organise a local activity',
    description: '[PLACEHOLDER: one-line description of organising a local activity]',
    href: '/contact',
    label: 'Get involved',
    imageAlt: '[PLACEHOLDER: photo of a local gathering]',
  },
];
---

<BaseLayout
  title="I LOVE SAI — Home"
  description="A global devotional and charitable movement centred on Shri Shirdi Sai Baba."
>
  <Hero
    eyebrow="[PLACEHOLDER: e.g. 'I LOVE SAI']"
    heading="Sabka Malik Ek"
    lead="[PLACEHOLDER: one line tying 'one God for all' to harmony across faiths and the movement's vision]"
    ctaLabel="Get Involved"
    ctaHref="/contact"
    slides={heroSlides}
  >
    <ArathiSchedule slot="aside" />
  </Hero>

  {
    /* Directly under the hero — the first thing past the title. Renders nothing
      at all when there's no active event (see lib/specialEvent.ts). */
  }
  <SpecialEvent />

  <section id="projects" aria-labelledby="projects-heading" class="bg-cream py-16 sm:py-24">
    <div class="px-gutter mx-auto max-w-6xl">
      <h2 id="projects-heading" class="text-h2 text-center">Latest from our projects</h2>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.cardDescription}
              href={`/projects/${project.slug}`}
              imageAlt={project.imageAlt}
              location={project.location}
            />
          ))
        }
      </div>
    </div>
  </section>

  {
    /* The vision was a contained 4:3 beside a paragraph on a colour ground.
      It is the one statement on the page about why any of this exists, so it
      gets the full width of the screen and the words sit on the photograph
      rather than next to it. */
  }
  <ImageBand
    id="vision"
    aria-labelledby="vision-heading"
    photoDescription="Devotees, garlands, and aarti — the warmth the vision is built on"
  >
    <h2 id="vision-heading" class="text-h1 text-cream">Our Vision</h2>
    <p class="text-lead text-cream/90 mx-auto mt-4 max-w-[var(--measure)]">
      [PLACEHOLDER: one line vision statement]
    </p>
  </ImageBand>

  <div class="bg-cream pb-16 text-center sm:pb-24">
    <PetalDivider variant="short" />
    <p class="eyebrow mt-4">[PLACEHOLDER: e.g. "Shraddha &amp; Saburi" — faith &amp; patience]</p>
  </div>

  <section
    id="participate"
    aria-labelledby="participate-heading"
    class="bg-sandal-deep py-16 sm:py-24"
  >
    <div class="px-gutter mx-auto max-w-6xl">
      <h2 id="participate-heading" class="text-h2 text-center">Ways to Participate</h2>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          participateOptions.map((option) => (
            <CTACard
              title={option.title}
              description={option.description}
              href={option.href}
              label={option.label}
              imageAlt={option.imageAlt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="where" aria-labelledby="where-heading" class="bg-cream py-12">
    <div class="px-gutter mx-auto max-w-6xl text-center">
      <h2 id="where-heading" class="eyebrow">Where We Are</h2>
      <p class="text-body text-ink mt-3">
        {
          locations.map((location, i) => (
            <>
              {i > 0 && ' · '}
              <a
                href={`/locations/${location.region.toLowerCase()}`}
                class="text-ink hover:text-ember-text"
              >
                {location.label}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </section>

  {
    /* A photograph of the work the gift funds, beside the ask — not a flat
      colour wash with a headline on it (styling-brief.md, HARD RULE). */
  }
  <ImageBand
    id="donate"
    aria-labelledby="donate-heading"
    layout="side"
    photoDescription="Aao Sai: Baba's photo installed in a family's home, clay lamps, prayers underway"
    class="bg-ember-deep"
  >
    <h2 id="donate-heading" class="text-h2 text-cream">
      [PLACEHOLDER: e.g. "Support the Mission"]
    </h2>
    <p class="text-sandal mt-3">[PLACEHOLDER: one line on where funds go]</p>
    <a
      href={DONATE_PATH}
      class="bg-marigold text-body text-ink shadow-soft hover:shadow-lift mt-8 inline-flex min-h-11 items-center justify-center rounded-sm px-6 py-3 font-semibold"
    >
      Donate Now
    </a>
  </ImageBand>
</BaseLayout>
